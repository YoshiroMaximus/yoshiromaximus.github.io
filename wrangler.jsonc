{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "snek",
	"main": "src/worker.js",
	"compatibility_date": "2026-04-29",
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false
		}
	},
	"assets": {
		"directory": ".",
		"binding": "ASSETS"
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "sn4k"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gambit-leaderboard",
			"database_id": "a0c9a032-45bc-4b83-87d4-afa599a9bc49"
		}
	],
	"unsafe": {
		"bindings": [
			{
				"name": "RATE_LIMITER",
				"type": "ratelimit",
				"namespace_id": "2001",
				"simple": {
					"limit": 10,
					"period": 60
				}
			}
		]
	}
}